# Copiá este archivo como `.env` y completá los valores.
# Se obtienen en el dashboard de Supabase: Project Settings → API
#
# El prefijo PUBLIC_ es de Astro: expone la variable al JavaScript del navegador.
# Es correcto para estas dos — la anon key está diseñada para ser pública y la
# seguridad real la da Row Level Security en la tabla, no el secreto de la clave.

PUBLIC_URL_SUPABASE=
PUBLIC_ANON_KEY_SUPABASE=
