---
import Layout from "../layouts/Layout.astro"
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import HeroPhoto from '../assets/images/hero-photo.webp';
import FotoContacto from '../assets/images/foto-2.webp';
const allCasos = await getCollection('casos');
const casos = allCasos.filter(caso => caso.id.startsWith("es/"));

// El pie de cada tarjeta: rótulo mono arriba, dato debajo. Se define una
// vez porque son tres columnas con el mismo tratamiento.
const rotulo = "font-mono text-micro uppercase tracking-widest text-content-subtle";
---
<Layout title="Carlos Coloma | Design System Manager & UX/UI Product Designer" description="Diseñador UX/UI y Design System Manager en Yanbal Internacional. Arquitectura de tokens, pipelines design-to-code y gobernanza de sistemas de diseño que escalan.">
	<section class="flex flex-col-reverse justify-center items-center w-full mx-auto gap-16 py-section px-margin-mobile lg:px-margin-desktop max-w-page lg:flex-row">
		<div class="flex flex-col w-full gap-6 max-w-full">
			<h1 class="text-display text-content lg:text-left text-center">Diseño y Gobierno <span class="text-gradient">Sistemas de Diseño</span><br class="hidden lg:flex"> que escalan</h1>
			<p class="text-lead border-l-2 border-border-strong pl-4">Cierro la brecha entre diseño e ingeniería: arquitectura de tokens, pipelines, design-to-code y la gobernanza que mantiene todo consistente.</p>
			<h2 class="text-subtitle"><span class="text-gradient">Design System Manager</span> en Yanbal Internacional</h2>
			<div class="flex flex-col sm:flex-row justify-center items-center md:justify-start gap-4">
				<Button variant="primary" href="/resume2026.pdf" target="_blank" rel="noopener noreferrer" >Ver CV</Button>
				<Button variant="secondary" href="/contacto">Contáctame</Button>
			</div>
		</div>
		<Image widths={[300, 400]} sizes="(min-width: 1024px) 560px, (min-width: 640px) 400px, 300px" loading="eager" fetchpriority="high" class="size-75 sm:size-100 lg:size-140 rounded-lg border border-border" src={HeroPhoto} alt="Foto de Carlos Coloma"/>
	</section>
	<section class="w-full">
		<div class="flex flex-col w-full justify-center items-center gap-8 py-section px-margin-mobile lg:px-margin-desktop mx-auto max-w-page">
			<h2 class="text-headline text-content">Proyectos destacados</h2>
			<p class="w-full lg:w-2/4 text-center text-lead">Una selección curada de los proyectos donde mi trabajo movió métricas de negocio y de producto. Cada caso parte de un problema real, explica la decisión de diseño y cierra con su impacto.</p>
			<div class="flex flex-col justify-center items-center gap-6 w-full">
				{casos.map((caso => {
					return <a href={`/casos/${caso.id.replace("es/", "")}`} class="flex flex-col-reverse group md:flex-row w-full gap-6 md:gap-8 p-6 bg-surface-raised border border-border rounded-sm hover:border-brand">
						<div class="flex flex-col gap-4 justify-between items-start w-full h-full">
							<div class="flex flex-col gap-4">
								<h3 class="text-title text-content group-hover:text-brand">{caso.data.title}</h3>
								<div class="text-lead">{caso.data.summary}</div>
							</div>
							<div class="flex flex-row gap-8 w-full justify-between">
								<div>
									<p class={rotulo}>Duración</p>
									<span class="text-content">{caso.data.date}</span>
								</div>
								<div>
									<p class={rotulo}>Rol</p>
									<span class="text-content">{caso.data.role}</span>
								</div>
								<div>
									<p class={rotulo}>Compañia</p>
									<span class="text-content">{caso.data.company}</span>
								</div>
							</div>
						</div>
						<div class="aspect-3/2 relative w-full h-full">
							<Image class="w-full h-full object-cover rounded-sm" alt={caso.data.title} src={caso.data.image} />
						</div>
					</a>
				}))}
			</div>
		</div>
	</section>
	<section class="bg-surface-raised border-y border-border w-full py-section flex flex-col items-center justify-center px-margin-mobile lg:px-margin-desktop">
		<p class="max-w-4xl font-medium text-title text-left">
			Soy Carlos Coloma, <span class="line-through font-light italic">Diseñador Gráfico</span> <span class="text-brand font-bold">Product Design, UI/UX y Design System Expert</span> de Lima, Perú, tengo 6+ años cerrando la brecha entre diseño e ingeniería en productos digitales.<br>Hoy dirijo <span class="text-content font-bold">FrYDA, el sistema de diseño de Yanbal</span> con <span class="underline">+35 componentes</span> tokenizados y publicados en NPM, con una reducción estimada de <span class="font-bold text-content">15-30%</span> en los tiempos de Diseño, Desarrollo y QA.
		</p>
		<div class="h-full w-full max-w-page items-center justify-evenly flex flex-col lg:flex-row py-section-inner gap-12 lg:gap-8">
			<a class="text-content font-mono text-mono underline hover:text-accent" rel="noreferrer" target="_blank" href="mailto:coloma.productdesign@gmail.com">coloma.productdesign@gmail.com</a>
			<Image class="size-75 rounded-sm border border-border object-cover" src={FotoContacto} alt="Carlos Coloma en la playa nadando con tortugas"/>
			<a href="https://www.linkedin.com/in/colomacarlos/" target="_blank" rel="noreferrer" class="flex flex-row gap-4 items-center group">
				<svg class="fill-content group-hover:fill-brand" width="32" height="32">
					<use xlink:href="/sprite.svg#linkedin" />
				</svg><span class="text-content font-mono text-mono group-hover:text-brand-bright">Conécta conmigo</span>
			</a>
		</div>
	</section>
</Layout>
