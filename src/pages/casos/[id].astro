---
import { Image } from 'astro:assets';
import Layout from "../../layouts/Layout.astro"
import type { GetStaticPaths } from "astro";
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
    const allCasos = await getCollection('casos')
    return allCasos.map(caso => {
        return {
            params: {
                id: caso.id
            },
            props: {
                caso
            }
        }
    });
}) satisfies GetStaticPaths;
const { caso } = Astro.props;
const { Content } = await render(caso);

---
<Layout>
    <main class="w-full max-w-dvw mx-auto prose prose-invert">
        <a class="font-bold p-4" href="/">🡐 Volver al inicio</a>
        <h1 class="text-6xl text-white font-semibold text-left">{caso.data.title}</h1>
        <p>{caso.data.summary}</p>
        <Image src={caso.data.image} alt={caso.data.title}/>
        <article class="flex flex-col m-12">
            <div class="flex flex-col m-6">
                <h2 class="text-lime-300">TL;DR:</h2>
                {caso.data.tldr}</div>
            <div class="grid grid-cols-2 grid-rows-2 m-6 gap-6">
                <div>
                <h3 class="text-gray-500">COMPAÑIA</h3>
                {caso.data.company}
                </div>

                <div>
                <h3 class="text-gray-500">ROL</h3>
                {caso.data.role}
                </div>

                <div>
                <h3 class="text-gray-500">SERVICIO</h3>
                <div class="flex flex-wrap gap-2">
                    {caso.data.tags.map(tag => <span class="text-sm border-2 font-bold py-0.5 px-2 rounded-full">{tag}</span>)}
                </div>
                </div>

                <div>
                <h3 class="text-gray-500">DURACIÓN</h3>
                {caso.data.date}
                </div>
            </div>
        </article>
        <Content />
    </main>
</Layout>