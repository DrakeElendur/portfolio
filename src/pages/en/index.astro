---
import Layout from "../../layouts/Layout.astro"
import { getCollection } from 'astro:content';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import HeroPhoto from '../../assets/images/hero-photo.webp';
import FotoContacto from '../../assets/images/foto-2.webp';
import { ordenarCasos } from '../../lib/casos';
const allCasos = await getCollection('casos');
const casos = ordenarCasos(allCasos.filter(caso => caso.id.startsWith("en/")));

// El pie de cada tarjeta: rotulo mono arriba, dato debajo. Se define una
// vez porque son tres columnas con el mismo tratamiento.
const rotulo = "font-mono text-micro uppercase tracking-widest text-content-subtle";
---
<Layout title="Carlos Coloma | Design System Manager & UX/UI Product Designer" description="UX/UI Designer and Design System Manager at Yanbal International. Token architecture, design-to-code pipelines, and design system governance that scales.">
	<section class="flex flex-col-reverse justify-center items-center w-full mx-auto gap-16 py-section px-margin-mobile lg:px-margin-desktop max-w-page lg:flex-row">
		<div class="flex flex-col w-full gap-6 max-w-full">
			<h1 class="text-display text-content lg:text-left text-center">Design and governance for <span class="text-gradient">design systems</span><br class="hidden lg:flex"> that scale</h1>
			<p class="text-lead border-l-2 border-border-strong pl-4">I close the gap between design and engineering: token architecture, pipelines, design-to-code, and the governance that keeps everything consistent.</p>
			<h2 class="text-subtitle"><span class="text-gradient">Design System Manager</span> at Yanbal International</h2>
			<div class="flex flex-col sm:flex-row justify-center items-center md:justify-start gap-4">
				<Button variant="primary" href="/resume2026-en.pdf" target="_blank" rel="noopener noreferrer" >View resume</Button>
				<Button variant="secondary" href="/en/contact">Contact me</Button>
			</div>
		</div>
		<Image widths={[300, 400]} sizes="(min-width: 1024px) 560px, (min-width: 640px) 400px, 300px" loading="eager" fetchpriority="high" class="size-75 sm:size-100 lg:size-140 rounded-lg border border-border" src={HeroPhoto} alt="Carlos Coloma's photo"/>
	</section>
	<section class="w-full">
		<div class="flex flex-col w-full justify-center items-center gap-8 py-section px-margin-mobile lg:px-margin-desktop mx-auto max-w-page">
			<h2 class="text-headline text-content">Featured projects</h2>
			<p class="w-full lg:w-2/4 text-center text-lead">A curated selection of projects where my work moved business and product metrics. Each case starts from a real problem, explains the design decision, and closes with its impact.</p>
			<div class="flex flex-col justify-center items-center gap-6 w-full">
				{casos.map((caso) => {
					return <a href={`/en/casos/${caso.id.replace("en/", "")}`} class="flex flex-col-reverse group md:flex-row w-full gap-6 md:gap-8 p-6 bg-surface-raised border border-border rounded-sm hover:border-brand">
						<div class="flex flex-col gap-4 justify-between items-start w-full h-full">
							<div class="flex flex-col gap-4">
								<h3 class="text-title text-content group-hover:text-brand">{caso.data.title}</h3>
								<div class="text-lead">{caso.data.summary}</div>
							</div>
							<div class="flex flex-row gap-8 w-full justify-between">
								<div>
									<p class={rotulo}>Timeline</p>
									<span class="text-content">{caso.data.date}</span>
								</div>
								<div>
									<p class={rotulo}>Role</p>
									<span class="text-content">{caso.data.role}</span>
								</div>
								<div>
									<p class={rotulo}>Company</p>
									<span class="text-content">{caso.data.company}</span>
								</div>
							</div>
						</div>
						<div class="aspect-3/2 relative w-full h-full">
							<Image class="w-full h-full object-cover rounded-sm" alt={caso.data.title} src={caso.data.image} />
						</div>
					</a>
				})}
			</div>
		</div>
	</section>
	<section class="bg-surface-raised border-y border-border w-full py-section flex flex-col items-center justify-center px-margin-mobile lg:px-margin-desktop">
		<p class="max-w-4xl font-medium text-title text-left">
			I'm Carlos Coloma, <span class="line-through font-light italic">Graphic Designer</span> <span class="text-brand font-bold">Design System Manager & UX/UI Product Designer</span> based in Lima, Peru, with 6+ years closing the gap between design and engineering in digital products.<br>Today, I lead <span class="text-content font-bold">FrYDA, Yanbal's design system,</span> with <span class="underline">37 tokenized components</span> published on NPM, delivering an estimated <span class="font-bold text-content">30-40%</span> reduction in design, development, and QA time.
		</p>
		<div class="h-full w-full max-w-page items-center justify-evenly flex flex-col lg:flex-row py-section-inner gap-12 lg:gap-8">
			<a class="text-content font-mono text-mono underline hover:text-accent" rel="noreferrer" target="_blank" href="mailto:coloma.productdesign@gmail.com">coloma.productdesign@gmail.com</a>
			<Image class="size-75 rounded-sm border border-border object-cover" src={FotoContacto} alt="Carlos Coloma diving next to a sea turtle"/>
			<a href="https://www.linkedin.com/in/colomacarlos/" target="_blank" rel="noreferrer" class="flex flex-row gap-4 items-center group">
				<svg class="fill-content group-hover:fill-brand" width="32" height="32">
					<use xlink:href="/sprite.svg#linkedin" />
				</svg><span class="text-content font-mono text-mono group-hover:text-brand-bright">Connect with me</span>
			</a>
		</div>
	</section>
</Layout>