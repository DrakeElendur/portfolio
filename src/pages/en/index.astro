---
import Layout from "../../layouts/Layout.astro"
import { getCollection } from 'astro:content';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import HeroPhoto from '../../assets/images/hero-photo.webp';
import FotoContacto from '../../assets/images/foto-2.webp';
const allCasos = await getCollection('casos');
const casos = allCasos.filter(caso => caso.id.startsWith("en/"));
---
<Layout title="Carlos Coloma | Design System Manager & UX/UI Product Designer" description="UX/UI Designer and Design System Manager at Yanbal International. Token architecture, design-to-code pipelines, and design system governance that scales.">
	<section class="flex flex-col-reverse justify-center items-center w-full mx-auto gap-16 py-30 px-8 lg:max-w-7xl lg:flex-row">
		<div class="flex flex-col w-full gap-6 max-w-full">
			<h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-6xl  text-white font-normal lg:text-left text-center">Design and Governance for <span class="text-lime-300">Design Systems</span><br class="hidden lg:flex"> that scale</h1>
			<p class="text-lg md:text-xl">I close the gap between design and engineering: token architecture, pipelines, design-to-code, and the governance that keeps everything consistent.</p>
			<h2 class="text-xl md:text-2xl"><span class="text-lime-300">Design System Manager</span> at Yanbal International</h2>
			<div class="flex flex-col sm:flex-row justify-center items-center md:justify-start gap-4">
				<Button variant="primary" href="/resume2026-en.pdf" target="_blank" rel="noopener noreferrer" >Full Resumé</Button>
				<Button variant="secondary" href="/en/contact">Contact me</Button>
			</div>
		</div>
		<Image class="size-75 sm:size-100 lg:size-140 rounded-full" src={HeroPhoto} alt="Carlos Coloma's photo"/>
	</section>
	<section class="bg-gray-800 w-full">
		<div class="flex flex-col w-full justify-center items-center gap-8 pt-30 px-8 lg:pt-20 lg:mx-auto lg:max-w-7xl">
			<h2 class="text-3xl md:text-4xl text-white">Featured projects</h2>
			<p class="w-full lg:w-2/4 text-center text-lg">A curated selection of projects where my work moved business and product metrics. Each case starts from a real problem, explains the design decision, and closes with its impact.</p>
			<div class="flex flex-col justify-center items-center">
				{casos.map((caso) => {
					return <a href={`/en/casos/${caso.id.replace("en/", "")}`} class="flex flex-col-reverse group lg:flex-row w-full gap-24 py-6 md:py-12 border-b">
						<div class="flex flex-col gap-4 justify-between items-start w-full h-full">
							<div class="flex flex-col gap-4">
								<div class="text-2xl text-white font-semibold group-hover:text-lime-300 group-hover:underline">{caso.data.title}</div>
								<div class="text-lg sm:text-xl">{caso.data.summary}</div>
							</div>
							<div class="flex flex-row gap-8 w-full justify-between">
								<div>
									<p>Duration</p>
									<span class="text-white">{caso.data.date}</span>
								</div>
								<div>
									<p>Role</p>
									<span class="text-white">{caso.data.role}</span>
								</div>
								<div>
									<p>Company</p>
									<span class="text-white">{caso.data.company}</span>
								</div>
							</div>
						</div>
						<div class="aspect-3/2 relative w-full h-full">
							<Image class="w-full h-full object-cover rounded-xl" alt={caso.data.title} src={caso.data.image} />
						</div>
					</a>
				})}
			</div>
		</div>
	</section>
	<section class="bg-gray-800 w-full py-16 md:py-24 flex flex-col items-center justify-center px-8 md:px-auto">
		<p class="max-w-4xl font-medium text-2xl md:text-3xl leading-9 text-left">
			I'm Carlos Coloma, <span class="line-through opacity-70 font-light italic">Graphic Designer</span> <span class="text-lime-300 font-bold">Product Design, UI/UX, and Design System Expert</span> based in Lima, Peru, with 6+ years closing the gap between design and engineering in digital products.<br>Today, I lead <span class="text-white font-bold">FrYDA, Yanbal's design system,</span> with <span class="underline">35+ tokenized components</span> published on NPM, delivering an estimated <span class="font-bold text-white">15-30%</span> reduction in Design, Development, and QA time.
		</p>
		<div class="h-full w-full lg:max-w-7xl items-center justify-evenly flex flex-col lg:flex-row py-24 gap-12 lg:gap-8">
			<a class="text-white text-xl sm:text-2xl underline hover:text-lime-300" rel="noreferrer" target="_blank" href="mailto:coloma.productdesign@gmail.com">coloma.productdesign@gmail.com</a>
			<Image class="size-75 rounded-3xl object-cover" src={FotoContacto} alt="Carlos Coloma in the sea swimming with turtles"/>
			<a href="https://www.linkedin.com/in/colomacarlos/" target="_blank" rel="noreferrer" class="flex flex-row gap-4 items-center group">
				<svg class="fill-white group-hover:fill-blue-500" width="32" height="32">
					<use xlink:href="/sprite.svg#linkedin" />
				</svg><span class="text-white text-2xl group-hover:text-lime-300">Connect with me</span>
			</a>
		</div>
	</section>
</Layout>