---
import type { GetStaticPaths } from "astro";
import { getCollection } from 'astro:content';
import CasoDetalle from '../../../components/CasoDetalle.astro';
export const getStaticPaths = (async () => {
    const allCasos = await getCollection('casos')
    return allCasos.filter(caso => caso.id.startsWith("en/")).map(caso => {
        return {
            params: {
                id: caso.id.replace("en/", "")
            },
            props: {
                caso
            }
        }
    });
}) satisfies GetStaticPaths;
const { caso } = Astro.props;
---
<CasoDetalle caso={caso}></CasoDetalle>