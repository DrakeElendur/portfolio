---
import Layout from "../../layouts/Layout.astro"
import Button from '../../components/Button.astro'
---
<Layout title="Contact | Carlos Coloma" description="Looking for a Design System Manager or UX/UI Product Designer for your team? Get in touch and let's talk.">
	<section class="flex flex-col justify-center items-center max-w-3xl w-full pt-30 px-8">
		<div class="flex flex-col justify-center items-center gap-2 pb-4">
			<h1 class="text-lime-300 text-3xl font-bold">Contact me</h1>
			<p class="text-xl text-center text-balance">I specialize in helping startups and teams move faster, smarter, and with more confidence. Reach out to see how we can work together.</p>
			<p id="mensajeExito" class="text-lg text-emerald-400"></p>
			<p id="mensajeError" class="text-lg text-red-500"></p>
		</div>
		<div class="w-full flex flex-col justify-center items-center gap-12 p-8 bg-gray-950 rounded-4xl">
			<form novalidate class="flex flex-col w-full gap-2">
				<div class="flex flex-col w-full justify-center items-center gap-4 sm:flex-row sm:justify-between">
					<div class="w-full flex flex-col gap-2">
						<label for="name" class="text-white text-lg">Your name</label>
						<input class="w-full bg-white p-4 rounded-lg text-base" type="text" id="name" name="name" placeholder="Enter your name" required>
						<p id="nameError" class=" text-red-500 text-sm"></p>
					</div>
					<div class="w-full flex flex-col gap-2">
						<label for="email" class="text-white text-lg">Your email</label>
						<input class="w-full bg-white p-4 rounded-lg text-base" type="email" id="email" name="email" placeholder="Enter your email" required>
						<p id="emailError" class=" text-red-500 text-sm"></p>
					</div>
				</div>
				<div class="w-full flex flex-col gap-2">
					<label for="message" class="text-white text-lg">How can I help you?</label>
					<textarea class="w-full bg-white p-4 rounded-lg text-base min-h-48" id="message" name="message" placeholder="Write your message here" required></textarea>
					<p id="messageError" class=" text-red-500 text-sm"></p>
				</div>
				<Button type="submit" variant="primary">Send message</Button>
			</form>
		</div>
	</section>
</Layout>
<script>
	import { createClient } from "@supabase/supabase-js";
	const supabaseUrl = import.meta.env.PUBLIC_URL_SUPABASE;
	const supabaseKey = import.meta.env.PUBLIC_ANON_KEY_SUPABASE;
	const supabase = createClient(supabaseUrl, supabaseKey);

	const form = document.querySelector("form");
	const name = document.querySelector<HTMLInputElement>("#name");
	const email = document.querySelector<HTMLInputElement>("#email");
	const message = document.querySelector<HTMLTextAreaElement>("#message");
	const nameError = document.querySelector("#nameError");
	const emailError = document.querySelector("#emailError");
	const messageError = document.querySelector("#messageError");
	const mensajeExito = document.querySelector("#mensajeExito");
	const mensajeError = document.querySelector("#mensajeError");



	if (form && name && email && message && nameError && emailError && messageError && mensajeExito && mensajeError) {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const valido = form.checkValidity();

			if (name.checkValidity() === false) {
				nameError.textContent = "❌ Please fill in this field";
			} else {
				nameError.textContent = "";
			};
			if (email.validity.valueMissing === true) {
				emailError.textContent = "❌ Please fill in this field";
			} else if(email.validity.typeMismatch === true) {
				emailError.textContent = "❌ Please enter a valid email";
			} else {
				emailError.textContent = "";
			};
			if (message.checkValidity() === false) {
				messageError.textContent = "❌ Please write a message before sending";
			} else {
				messageError.textContent = "";
			};

			if (valido === true) {
				const { data, error } = await supabase.from("Contactos").insert({
					name: name.value,
					email: email.value,
					message: message.value,
				});
				if (error) {
					mensajeError.textContent = "❌ Error sending message"
                    mensajeExito.textContent = "";
				} else {
					mensajeExito.textContent = "✅ Message sent successfully";
					form.reset();
					nameError.textContent = "";
					emailError.textContent = "";
					messageError.textContent = "";
                    mensajeError.textContent = "";
				}
			} else {
			};
		});
	}
</script>