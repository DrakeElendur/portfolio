---
import Layout from "../../layouts/Layout.astro"
import Button from '../../components/Button.astro'

// Una sola definición del campo: antes estaba repetida tres veces.
// El fondo hundido + borde sustituye al `bg-white`, que era el único
// elemento claro de toda la interfaz oscura.
// El borde de error lo pinta el CSS reaccionando a `aria-invalid`, así
// que el script solo gobierna un atributo y no toca clases.
const campo = "w-full bg-surface-deep border border-border p-4 rounded-lg text-body text-content placeholder:text-content-muted aria-[invalid=true]:border-danger";
const errorCampo = "text-danger text-caption empty:hidden";
const aviso = "hidden data-[show=true]:flex items-center gap-2 text-body";
---
<Layout title="Contact | Carlos Coloma" description="Looking for a Design System Manager or UX/UI Product Designer for your team? Get in touch and let's talk.">
	<section class="flex flex-col justify-center items-center max-w-3xl w-full py-section px-8">
		<div class="flex flex-col justify-center items-center gap-2 pb-8">
			<h1 class="text-brand text-headline font-bold">Contact me</h1>
			<p class="text-lead text-center text-balance">I specialize in helping startups and teams move faster, smarter, and with more confidence. Reach out to see how we can work together.</p>
		</div>
		<div class="w-full flex flex-col justify-center items-center gap-12 p-8 bg-surface-raised rounded-4xl">
			<form novalidate class="flex flex-col w-full gap-4">
				<div class="flex flex-col w-full justify-center items-start gap-4 sm:flex-row sm:justify-between">
					<div class="w-full flex flex-col gap-2">
						<label for="name" class="text-content text-body">Your name</label>
						<input class={campo} type="text" id="name" name="name" placeholder="Enter your name" required aria-describedby="nameError">
						<p id="nameError" class={errorCampo}></p>
					</div>
					<div class="w-full flex flex-col gap-2">
						<label for="email" class="text-content text-body">Your email</label>
						<input class={campo} type="email" id="email" name="email" placeholder="Enter your email" required aria-describedby="emailError">
						<p id="emailError" class={errorCampo}></p>
					</div>
				</div>
				<div class="w-full flex flex-col gap-2">
					<label for="message" class="text-content text-body">How can I help you?</label>
					<textarea class={`${campo} min-h-48`} id="message" name="message" placeholder="Write your message here" required aria-describedby="messageError"></textarea>
					<p id="messageError" class={errorCampo}></p>
				</div>
				<!-- La confirmación vive junto al botón, que es donde el usuario
				     está mirando cuando la dispara. Antes estaba en la cabecera
				     de la página y en móvil quedaba fuera de pantalla. -->
				<div class="flex flex-col gap-3">
					<Button type="submit" variant="primary">Send message</Button>
					<p id="mensajeExito" data-show="false" role="status" class={`${aviso} text-success`}>
						<svg class="size-5 shrink-0 fill-current" aria-hidden="true" focusable="false"><use xlink:href="/sprite.svg#verified" /></svg>
						<span>Message sent successfully</span>
					</p>
					<p id="mensajeError" data-show="false" role="alert" class={`${aviso} text-danger`}>
						<svg class="size-5 shrink-0" aria-hidden="true" focusable="false"><use xlink:href="/sprite.svg#close" /></svg>
						<span>Your message couldn't be sent. Please try again.</span>
					</p>
				</div>
			</form>
		</div>
	</section>
</Layout>
<script>
	import { createClient } from "@supabase/supabase-js";
	const supabaseUrl = import.meta.env.PUBLIC_URL_SUPABASE;
	const supabaseKey = import.meta.env.PUBLIC_ANON_KEY_SUPABASE;
	const supabase = createClient(supabaseUrl, supabaseKey);

	const form = document.querySelector("form");
	const name = document.querySelector<HTMLInputElement>("#name");
	const email = document.querySelector<HTMLInputElement>("#email");
	const message = document.querySelector<HTMLTextAreaElement>("#message");
	const nameError = document.querySelector("#nameError");
	const emailError = document.querySelector("#emailError");
	const messageError = document.querySelector("#messageError");
	const mensajeExito = document.querySelector<HTMLElement>("#mensajeExito");
	const mensajeError = document.querySelector<HTMLElement>("#mensajeError");
	const enviar = document.querySelector<HTMLButtonElement>("button[type=submit]");

	// Marca un campo como inválido y escribe su mensaje. `aria-invalid`
	// hace dos trabajos a la vez: se lo comunica al lector de pantalla y
	// dispara el borde rojo vía CSS. Un solo atributo, dos efectos.
	const marcar = (campo: HTMLInputElement | HTMLTextAreaElement, salida: Element, mensaje: string) => {
		salida.textContent = mensaje;
		campo.setAttribute("aria-invalid", mensaje ? "true" : "false");
		return mensaje === "";
	};

	const avisar = (elemento: HTMLElement | null, visible: boolean) => {
		elemento?.setAttribute("data-show", String(visible));
	};

	if (form && name && email && message && nameError && emailError && messageError) {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const okNombre = marcar(name, nameError, name.checkValidity() ? "" : "Please complete this field");
			const okEmail = marcar(email, emailError,
				email.validity.valueMissing ? "Please complete this field"
					: email.validity.typeMismatch ? "Enter a valid email address"
						: "");
			const okMensaje = marcar(message, messageError, message.checkValidity() ? "" : "Write your message so it can be sent");

			if (!(okNombre && okEmail && okMensaje)) {
				// Llevar el foco al primer campo con problema evita que el
				// usuario tenga que buscarlo, sobre todo en móvil.
				form.querySelector<HTMLElement>("[aria-invalid=true]")?.focus();
				return;
			}

			avisar(mensajeExito, false);
			avisar(mensajeError, false);
			if (enviar) enviar.disabled = true;

			const { error } = await supabase.from("Contactos").insert({
				name: name.value,
				email: email.value,
				message: message.value,
			});

			if (enviar) enviar.disabled = false;

			if (error) {
				avisar(mensajeError, true);
			} else {
				avisar(mensajeExito, true);
				form.reset();
				marcar(name, nameError, "");
				marcar(email, emailError, "");
				marcar(message, messageError, "");
			}
		});
	}
</script>
