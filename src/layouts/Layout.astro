---
import "../styles/global.css"
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
// `?url` devuelve la ruta final con hash que Vite le da al archivo. Hace
// falta para poder precargarlo: el nombre lo decide el build, así que
// escribirlo a mano en un <link> se rompería en el siguiente despliegue.
import montserratUrl from '../assets/fonts/Montserrat-VariableFont_wght.woff2?url'
import { rutaAlterna } from '../lib/rutas';
interface Props {
    title: string;
    description: string;
    image?: string;
    /** Para páginas que no son contenido real, como la 404. */
    noindex?: boolean;
};
const isEnglish = Astro.currentLocale === 'en';

// La tarjeta social por defecto. 1200x630 es el formato que esperan
// LinkedIn, WhatsApp y X; la foto del hero, que era lo que había antes,
// mide 400x400 y salía recortada. Las fichas de caso pasan su propia
// portada por `image`, así que esta solo cubre home, sobre-mí y contacto.
const tarjetaPorDefecto = new URL('/og-default.png', Astro.site).href;
const { title, description, image = tarjetaPorDefecto, noindex = false } = Astro.props;
// Las dimensiones solo se anuncian cuando se conocen. Las fichas de caso
// pasan su propia portada, que tiene otra proporción: declararle 1200x630
// haría que el cliente reserve un hueco del tamaño equivocado.
const esTarjetaPorDefecto = image === tarjetaPorDefecto;

// Absolutas y con barra final, igual que las que publica el sitemap.
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const alterna = new URL(rutaAlterna(Astro.url.pathname, isEnglish), Astro.site).href;
const [urlEs, urlEn] = isEnglish ? [alterna, canonica] : [canonica, alterna];
---
<!DOCTYPE html>
<html lang={isEnglish ? "en" : "es"}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- Montserrat es local y pinta el h1, que es lo primero que se ve.
             Se precarga para que el navegador la pida YA, en paralelo con el
             CSS. Sin esto no la descubre hasta terminar de parsear la hoja de
             estilos, y el titular se queda esperando. `crossorigin` no es
             opcional en un preload de fuente: sin él el navegador descarga el
             archivo dos veces. -->
        <link rel="preload" href={montserratUrl} as="font" type="font/woff2" crossorigin />
        <!-- Hanken Grotesk y JetBrains Mono vienen de Google Fonts. `preconnect`
             adelanta DNS y handshake TLS, que es la mayor parte del coste.

             El truco de `media="print"`: una hoja para otro medio NO bloquea el
             render, así que la página pinta sin esperar al tercer dominio. Al
             terminar de bajar, el `onload` la devuelve a `all` y se aplica.
             Ninguna de las dos familias hace falta para el primer pintado —
             son cuerpo y etiquetas, no el titular. El <noscript> cubre el caso
             sin JavaScript. -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400..700&display=swap" />
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400..700&display=swap" /></noscript>
        <!-- Tags de SEO -->
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <!-- La 404 no es contenido: no se indexa, y tampoco declara canonical
             ni alternates. Una página de error dentro de un grupo hreflang le
             diría a Google que es la versión válida de algo. -->
        {noindex
            ? <meta name="robots" content="noindex, follow" />
            : (
                <>
                    <link rel="canonical" href={canonica} />
                    {/* El sitio existe entero en dos idiomas. Sin esto, Google trata
                        `/sobre-mi/` y `/en/about/` como contenido duplicado y elige
                        una por su cuenta, en vez de servir la que corresponde a cada
                        usuario.

                        Las tres etiquetas son necesarias: cada idioma se declara a sí
                        mismo además de a su pareja (así el grupo es recíproco y Google
                        lo valida), y `x-default` marca a dónde mandar a quien no habla
                        ninguno de los dos. */}
                    <link rel="alternate" hreflang="es" href={urlEs} />
                    <link rel="alternate" hreflang="en" href={urlEn} />
                    <link rel="alternate" hreflang="x-default" href={urlEs} />
                </>
            )}
        <!-- Tags de Open Graph-->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website">
        <meta property="og:url" content={canonica} />
        <meta property="og:image" content={image} />
{esTarjetaPorDefecto && (<><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>)}
        <meta property="og:locale" content={isEnglish ? "en_US" : "es_ES"} />
        <meta property="og:locale:alternate" content={isEnglish ? "es_ES" : "en_US"} />
        <meta property="og:site_name" content="Carlos Coloma" />
        <!-- X/Twitter no lee Open Graph para el formato de la tarjeta: sin
             `twitter:card` muestra la miniatura pequeña en vez de la grande. -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <!-- Analíticas de Vercel -->
        <Analytics />
        <SpeedInsights/>
        <!-- Titulo de la Página -->
        <title>{title}</title>
    </head>
    <body class="flex flex-col items-center w-full bg-surface min-w-0 text-content-muted font-body">
        <!-- Carcasa ambiental: rejilla, rieles de margen y marcadores de esquina.
             Es decoración pura, por eso va con aria-hidden y pointer-events-none.

             `-z-10` en vez del `z-0` del mockup: el fondo de <body> se propaga al
             lienzo del navegador, así que se pinta por debajo de todo. Un z-index
             negativo deja la rejilla encima de ese lienzo pero detrás del
             contenido, sin tener que ir marcando `relative z-10` en cada sección.

             Nada de `overflow-x-hidden` en el body: crearía un contenedor de
             scroll y rompería el `sticky` del nav y el de la ficha de caso. -->
        <div class="fixed inset-0 -z-10 pointer-events-none grid-bg" aria-hidden="true"></div>
        <!-- Los rieles cuelgan de un contenedor centrado del mismo ancho que la
             página (max-w-page) en lugar de anclarse al borde de la ventana. Así
             caen exactamente sobre el padding `margin-desktop` del contenido a
             CUALQUIER resolución; anclados al viewport se desalineaban en cuanto
             la pantalla superaba los 1440px. -->
        <div class="fixed inset-y-0 left-1/2 -translate-x-1/2 w-full max-w-page -z-10 pointer-events-none hidden md:block" aria-hidden="true">
            <div class="absolute inset-y-0 left-margin-desktop w-px bg-border"></div>
            <div class="absolute inset-y-0 right-margin-desktop w-px bg-border"></div>
            <span class="absolute top-nav left-margin-desktop -translate-x-1/2 select-none text-border-strong font-mono text-mono">+</span>
            <span class="absolute top-nav right-margin-desktop translate-x-1/2 select-none text-border-strong font-mono text-mono">+</span>
        </div>
        <Nav />
        <main class="flex flex-col w-full items-center mx-auto min-w-0 min-h-dvh">
            <slot />
        </main>
        <Footer />
    </body>
</html>