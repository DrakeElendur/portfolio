---
interface Props{
    variant: "primary" | "secondary";
    href: string;
    target?: string;
    rel?: string;
}
const { variant, href, target, rel } = Astro.props;
---
<a 
    href={href} 
    target={target} 
    rel={rel} 
    class:list={[
        "inline-block px-8 py-3 rounded-full", 
        (variant ==="primary") ? "bg-blue-500 hover:bg-blue-700 text-white" : "text-white border-2 hover:text-gray-300",]}>
    <slot />
</a>