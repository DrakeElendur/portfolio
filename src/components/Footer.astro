---
const isEnglish = Astro.currentLocale === 'en';
---
<footer class="flex flex-col items-center justify-center w-full bg-gray-800">
    <section class="flex flex-col md:flex-row justify-between w-full pt-24 pb-8 px-8 lg:px-24 gap-4">
        <div class="w-full flex flex-col justify-between">
            <p class="text-xl text-white font-bold font-montserrat">Carlos Coloma</p>
            <p class="max-w-sm">{isEnglish ? "Senior Product Designer, UX/UI and Design System Manager based in Lima, Peru" : "Diseñador de Producto Senior, UX/UI y Design System Manager en Lima, Perú"}</p>
        </div>
        <div class="flex flex-col md:flex-row w-full justify-evenly gap-4 md:gap-8">
            <ul>
                <li><h2 class="">{isEnglish ? "Navigation" : "Navegación"}</h2></li>
                <li><a class="text-white hover:text-lime-300" href={isEnglish ? "/en" : "/"}>{isEnglish ? "Home" : "Inicio"}</a></li>
                <li><a class="text-white hover:text-lime-300" href={isEnglish ? "/en/about" : "/sobre-mi"}>{isEnglish ? "About Me" : "Sobre mi"}</a></li>
                <li><a class="text-white hover:text-lime-300" href={isEnglish ? "/en/contact" : "/contacto"}>{isEnglish ? "Contact Me" : "Contacto"}</a></li>
            </ul>
            <ul>
                <li><h2 class="">{isEnglish ? "Social Media" : "Redes sociales"}</h2></li>
                <li><a class="text-white hover:text-lime-300" href="mailto:coloma.productdesign@gmail.com">Email</a></li>
                <li><a class="text-white hover:text-lime-300" href="https://www.linkedin.com/in/colomacarlos/">Linkedin</a></li>
                <li><a class="text-white hover:text-lime-300" href="https://www.instagram.com/carlos.ux/">Instagram</a></li>
            </ul>
        </div>
    </section>
    <section class="flex flex-col md:flex-row w-full justify-between py-6 px-8 lg:px-24 border-t gap-2">
        <p class="text-left">© 2026 Carlos Coloma Martínez</p>
        <p class="text-left md:text-right">{isEnglish ? "All right reserved. Built with " : "Todos los derechos reservados. Construido con "}<a href="https://astro.build/" target="_blank" rel="noreferrer" class="hover:underline text-lime-300">Astro</a></p>
    </section>
</footer>